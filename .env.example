# Every variable src/config/index.js reads, and nothing else. Copy to .env for
# local development. On Atlas, set only the ones marked "set in Atlas"; the ones
# marked "injected" arrive automatically from the service's `needs`.

# ---- Telegram (set in Atlas) ----
# From BotFather. Keep this secret.
BOT_TOKEN=123456789:AA-your-bot-token-here
# The bot's @username (without the @). Required when the web board is on — it
# builds the "Add the bot to your group" link: https://t.me/<BOT_USERNAME>?startgroup=true
BOT_USERNAME=YourBot

# ---- PostgreSQL (injected by Atlas for needs: ["postgres"]) ----
# Prisma reads this for both the app and migrations. Locally, point it at your
# own server and create the tables with `npm run db:dev`.
DATABASE_URL=postgres://canany:canany@localhost:5432/canany

# ---- Web board (set in Atlas) ----
# Signs the session cookie. Required when the web board is on. Use 32+ random
# chars, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Optional bootstrap kill-switch. Leave blank for open signup; set it to require
# this code on the signup form (gate signups to invited users).
SIGNUP_CODE=

# ---- Attachments (injected by Atlas for needs: ["minio"]) ----
# Any S3-compatible bucket for files sent with an #ask. Leave S3_BUCKET blank to
# disable attachments (asks still work text-only). The bucket must be private.
# S3_ENDPOINT blank = AWS S3 proper. S3_ACCESS_KEY + S3_SECRET_KEY blank = the
# AWS SDK's default credential chain (an IAM instance role, for instance).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_FORCE_PATH_STYLE=

# ---- Optional behaviour (defaults shown; not set in Atlas) ----
# The prefix that marks a message as a new ask (it's stripped before saving).
# Quote it — a bare # starts a comment in .env, so ASK_PREFIX=#ask parses as empty.
ASK_PREFIX="#ask"
# /stalled flags asks left open longer than this many days.
STALLED_DAYS=2
# Set WEB_ENABLED=false for a pure-bot process with no web board and no open
# port (never on Atlas, which needs the port to answer).
WEB_ENABLED=true
# Set WEB_ONLY=true locally to preview the web UI without Telegram polling or a
# database.
WEB_ONLY=false
