{
  "name": "canany",
  "version": "1.0.0",
  "description": "Can Anyone — an open asks board that lives inside Telegram, with a web board (Node.js bot + PostgreSQL via Prisma)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "migrate": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:dev": "prisma migrate dev",
    "pm2:start": "pm2 start src/index.js --name canany",
    "pm2:logs": "pm2 logs canany",
    "pm2:restart": "pm2 restart canany",
    "pm2:stop": "pm2 stop canany"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/lib-storage": "^3.1079.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.22.2",
    "node-telegram-bot-api": "^0.66.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "pm2": "^5.4.2"
  }
}
